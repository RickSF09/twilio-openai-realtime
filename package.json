{
  "name": "twilio-openai-realtime",
  "version": "1.0.0",
  "description": "Backend server integrating Twilio Voice with OpenAI Realtime API for dynamic AI-powered voice calls",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "dev:clean": "pkill -f 'ts-node src/index.ts' || true; pkill -f nodemon || true; sleep 1",
    "dev:start": "pnpm dev:clean && pnpm dev",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "twilio",
    "openai",
    "realtime-api",
    "voice",
    "ai",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "axios": "^1.13.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "twilio": "^5.10.4",
    "ws": "^8.18.3"
  }
}
