# Twilio Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# N8N Webhook Authentication
N8N_WEBHOOK_AUTH=your_secure_auth_token_here

# Server Configuration
PORT=5050
NODE_ENV=development

# Optional: Default Configuration
DEFAULT_VOICE=marin
DEFAULT_TEMPERATURE=0.8
DEFAULT_MODEL=gpt-realtime
DEFAULT_N8N_WEBHOOK_URL=

# Alerting
ALERTS_ENABLED=true
ALERTS_SLACK_WEBHOOK_URL=
ALERTS_DEFAULT_SEVERITY=P2
ALERTS_MIN_INTERVAL_SECONDS=600
ALERTS_SERVICE_NAME=twilio-openai-realtime
ALERTS_INCLUDE_FULL_PAYLOAD=true
HEARTBEAT_INTERVAL_SECONDS=300

# Readiness
READINESS_FORCE_ERROR=
